{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myorg.example/schemas/payments/external-events.schema.json",
  "title": "Payments external domain events",
  "description": "What the payments subsystem shares with other subsystems: outcomes only. A stable contract: fields are only ever added; renames and removals go through three deployments and a roadmap agreed with consumers.",
  "type": "object",
  "required": ["id", "type", "timestamp", "partitionKey", "payment"],
  "properties": {
    "id": { "type": "string", "description": "Deterministic: the same fact always has the same id. Consumers drop repeats." },
    "type": { "enum": ["PAYMENTS.PAYMENT_COMPLETED", "PAYMENTS.PAYMENT_FAILED"] },
    "timestamp": { "type": "integer", "description": "Epoch ms when the outcome was decided." },
    "partitionKey": { "type": "string", "description": "The payment id." },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "source": { "const": "payments-egress-gateway" },
        "subsystem": { "const": "payments" }
      }
    },
    "payment": {
      "type": "object",
      "required": ["id", "customerId", "amount", "currency", "destination", "submittedAt"],
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$", "description": "A decimal as a string, two decimals." },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217." },
        "destination": { "enum": ["card", "bank"] },
        "submittedAt": { "type": "integer", "description": "Epoch ms." }
      }
    },
    "reason": {
      "enum": ["insufficient-funds", "account-closed", "account-not-found", "rejected"],
      "description": "On PAYMENTS.PAYMENT_FAILED only. Consumers must treat an unknown value as rejected."
    }
  },
  "if": { "properties": { "type": { "const": "PAYMENTS.PAYMENT_FAILED" } } },
  "then": { "required": ["reason"] },
  "else": { "not": { "required": ["reason"] } }
}
